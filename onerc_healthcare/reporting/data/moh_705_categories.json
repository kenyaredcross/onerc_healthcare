 "no_icd11_equivalent": [
  {"form": "705A", "line": "Diarrhoea with no dehydration / some dehydration / severe dehydration", "reason": "ICD-11 has no dehydration grade. 5C70.0 Dehydration exists but carries no WHO/IMCI grade. All diarrhoea is counted as one line; the graded lines are Gap elements."},
  {"form": "705A", "line": "Severe pneumonia (vs pneumonia)", "reason": "ICD-11 pneumonia (CA40) has no severity axis. All pneumonia is counted as one line; Severe pneumonia is a Gap element."},

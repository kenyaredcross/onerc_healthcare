   "label": "Risk Factors and Remarks"
  },
  {
   "fieldname": "risk_factors",
   "fieldtype": "Small Text",
   "label": "Risk Factors",
   "description": "e.g. previous caesarean, age under 18 or over 35, grand multipara, previous stillbirth."
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "fieldname": "closure_section",
   "fieldtype": "Section Break",

   "label": "Syphilis",
   "options": "\nNon-reactive\nReactive\nNot tested"
  },
  {
   "fieldname": "hepatitis_b",
   "fieldtype": "Select",
   "label": "Hepatitis B",
   "options": "\nNegative\nPositive\nNot tested"

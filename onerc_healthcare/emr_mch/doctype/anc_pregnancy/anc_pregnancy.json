   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "default": "ANC-.YYYY.-",
   "options": "ANC-.YYYY.-",
   "hidden": 1,
   "no_copy": 1,
   "print_hide": 1,
   "reqd": 1,
   "set_only_once": 1,
   "description": "Set per operation in EMR Naming Settings (D19)."
  },
  {
   "fieldname": "patient",
   "fieldtype": "Link",
   "label": "Mother",
   "options": "Patient",
   "reqd": 1,
   "in_standard_filter": 1,
   "search_index": 1,
   "set_only_once": 1
  },
  {
   "fieldname": "patient_name",
   "fieldtype": "Data",
   "label": "Mother's Name",
   "fetch_from": "patient.patient_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "facility",
   "fieldtype": "Link",
   "label": "Facility",
   "options": "Healthcare Service Unit",
   "reqd": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_head",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Open\nClosed",
   "default": "Open",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "no_copy": 1
  },
  {
   "fieldname": "booking_date",
   "fieldtype": "Date",
   "label": "Booking Date",
   "default": "Today",
   "reqd": 1
  },
  {
   "fieldname": "booking_visit",
   "fieldtype": "Link",
   "label": "Booking Visit",
   "options": "Patient Visit",
   "set_only_once": 1
  },
  {
   "fieldname": "pregnancy_section",
   "fieldtype": "Section Break",
   "label": "Pregnancy"
  },
  {
   "fieldname": "lmp",
   "fieldtype": "Date",
   "label": "LMP"
  },
  {
   "fieldname": "edd_basis",
   "fieldtype": "Select",
   "label": "EDD Basis",
   "options": "LMP\nUltrasound\nClinical estimate",
   "default": "LMP",
   "description": "LMP: the EDD is LMP + 280 days. Ultrasound / Clinical estimate: the EDD is typed."
  },
  {
   "fieldname": "edd",
   "fieldtype": "Date",
   "label": "EDD",
   "in_list_view": 1,
   "read_only_depends_on": "eval:(doc.edd_basis || 'LMP') == 'LMP' && doc.lmp"
  },
  {
   "fieldname": "column_break_pregnancy",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "gravida",
   "fieldtype": "Int",
   "label": "Gravida",
   "description": "Every pregnancy including this one."
  },
  {
   "fieldname": "para",
   "fieldtype": "Data",
   "label": "Para",
   "description": "Earlier births (+ abortions), e.g. 2+1."
  },
  {
   "fieldname": "gestation",
   "fieldtype": "Data",
   "label": "Gestation Today",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "booking_tests_section",
   "fieldtype": "Section Break",
   "label": "Booking Tests"
  },
  {
   "fieldname": "blood_group",

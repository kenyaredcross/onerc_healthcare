  },
  {
   "fieldname": "delivery_record",
   "fieldtype": "Link",
   "label": "Delivery Record",
   "options": "Delivery Record",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "closure_note",
   "fieldtype": "Small Text",
   "label": "Closure Note",
   "read_only": 1,
   "no_copy": 1
  },
  {
